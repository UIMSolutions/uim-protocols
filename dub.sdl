// Metadata
name "uim-protocols"
description "UIM Plattform"
homepage "https://www.....de/uim/protocols"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

// Target
targetType "library"
targetName "uim-protocols"

// External dependencies
dependency "uim-framework" version="~>26.7.1"
dependency "vibe-d" version="~>0.10.3"
dependency "gtk-d" version="~>3.11.0"

// Internal Dependencies
dependency ":protocol" version="*"

dependency ":adatp3" version="*"
dependency ":adif" version="*"
dependency ":elf" version="*"
dependency ":edifact" version="*"
dependency ":ftam" version="*"
dependency ":s2000m" version="*"
dependency ":scim" version="*"
dependency ":uart" version="*"
dependency ":zugferd" version="*"

// Source files
sourceFiles "./source/uim/protocols/all.d"

// Subpackages
subPackage "protocol"

subPackage "adatp3"
subPackage "adif"
subPackage "elf"
subPackage "edifact"
subPackage "ftam"
subPackage "s2000m"
subPackage "scim"
subPackage "uart"
subPackage "zugferd"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"